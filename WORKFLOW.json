      ],
      "id": "a22bbb1f-6c09-47cb-a885-7c93b53d0cdc",
      "name": "EMAIL WEBSITE"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Sujet :{{ $('Gmail Trigger').item.json.Subject }}\n\nContenu : {{ $('Gmail Trigger').item.json.snippet }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "RÔLE : Tu es un assistant de gestion de messagerie de haut niveau. Ta mission est de préparer des brouillons de réponse parfaits pour les emails reçus.\n\nINSTRUCTIONS DE RÉDACTION :\n\nLangue : Réponds impérativement dans la langue de l'email reçu.\n\nSujet : Crée un objet court et explicite commençant par \"RE: \".\n\nCorps : > - Utilise un ton professionnel et chaleureux.\n\nSi c'est un email de service (ex: Ryanair), confirme la bonne prise en compte.\n\nSi c'est un humain, remercie-le et indique que \"je reviens vers vous rapidement\".\n\nSigne avec \"Cordialement, [ AFFAIRE\".\n"
        }
      },
